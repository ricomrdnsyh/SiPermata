{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && tailwindcss -i resources/css/landingpage.css -o public/assets/css/landingpage.css --minify",
        "build:landing": "tailwindcss -i resources/css/landingpage.css -o public/assets/css/landingpage.css --minify",
        "watch:landing": "tailwindcss -i resources/css/landingpage.css -o public/assets/css/landingpage.css --watch",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
